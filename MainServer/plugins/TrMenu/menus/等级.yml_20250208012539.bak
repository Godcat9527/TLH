Title: '&6&lTLH &a&l等级升级'

Layout:
  - '@@@@A@@@@'
  - '@1234567@' 
  - '@@@@#@@@@'

Options:
  Arguments: false
  Default-Arguments: [ ]
  Default-Layout: 0
  Min-Click-Delay: 200
  Pure-Packet: false


Icons: 
  '#':
    display: 
      material: red_stained_glass_pane 
      name: '&c返回主菜单'
    action: 
      all: 
        - 'open: 主菜单' 
        - 'sound: BLOCK_NOTE_BLOCK_COW_BELL' 


  '@':
    display: 
      material: light_blue_stained_glass_pane 
      name: ' '


  'A':
      display: 
        material: red_bed
      icons:
       - display: 
          material: red_bed
          name: '&{#FFE7BA}&l初来乍到'
          lore:
            - ''
            - '&{#B0C4DE}当前等级: 普通玩家'
            - '&{#B0C4DE}下一个等级: 初来乍到'
            - ''
            - '&{#D3D3D3}&l解锁条件:'
            - '&{#B0C4DE}完成5个每日任务'
            - ''
            - '&{#ff3300}花费5000星币解锁!'
            - ''
            - '&fㆵ &{#FFFACD}点击进行解锁'
         action: 
            left:
              - condition: 'money *5000'
                actions:
                  - 'close'
                  - ''
                  - 'take-money: 5000'
                  - 'console: lp user %player_name% parent set 初来乍到1'
                  - 'title: &a你已经成功解锁!' 
                deny:
                  - 'close'
                  - 'title: &c你的星币不足!' 
         priority: 78
         condition: 'check papi *%odailyquests_total% >= *1'
       - display:
          material: red_bed
          name: '&{#FFE7BA}&l初来乍到'
          lore:
            - ''
            - '&{#B0C4DE}当前等级: 普通玩家'
