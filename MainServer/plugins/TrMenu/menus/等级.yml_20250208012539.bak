            - ''
            - '&{#ff3300}尚未达到解锁条件!'
            - '你当前的任务数量%odailyquests_total%'
         priority: 79
#==========================================================
       - display:
          material: red_bed
          name: '&{#FFE7BA}&l初来乍到'
          lore:
            - ''
            - '&{#B0C4DE}当前等级: 初来乍到'
            - '&{#B0C4DE}下一个等级: 踏上旅程'
            - ''
