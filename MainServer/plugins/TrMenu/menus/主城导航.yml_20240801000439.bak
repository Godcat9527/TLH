title: '&6&lTLH &a&l主城导航'

Layout:
  - '@@@ @@ @@'
  - '@@ @@@@ @' 
  - '@ @@@@@ @'  
  - '@@ @@@@@@'  
  - '@@@@@@@@@'  
  - '@@@@ @@@@'

Icons:
 
  '@':
    display:
      material: green_stained_glass_pane
      name: ' '

  'Spawn':
    display:
      material: red_bed
      name: '主城导航处'
      slots: 49
      lore:
        - ''
        - '&a你正在此处'

  'Clothes':
    display:
      material: chainmail_chestplate
      name: '服装店'
      slots: 29
      lore:
        - ''
        - '&f可以在此替换时装'
    action:
      all:
        - 'console: tppos -p:%player_name% 185 117 125 spawn 0 -90'
        - 'close'

  'Rank':
    display:
      material: gold_ingot
      name: '排行榜'
      slots: 19
      lore:
        - ''
        - '&f可以在此查看财富排行'
    action:
      all:
        - 'console: tppos -p:%player_name% 218 120 190 spawn 0 -90'
        - 'close'

 'Market':
    display:
      material: oak_chest_boat
      name: '集市'
      slots: 19
      lore:
        - ''
        - '&f可以在此购买或出售物品'
    action:
      all:
        - 'console: tppos -p:%player_name% 88 119 128 spawn 0 30'
        - 'close'