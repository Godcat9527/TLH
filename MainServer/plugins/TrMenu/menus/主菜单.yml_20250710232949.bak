Title: 
  - '&6&lTLH &2&l&k| &r&l主菜单'

Title-Update: 50


Layout:
  - '@#@# #@#@' 
  - ' $$$ $$$ '
  - '@$$ % $$@' 
  - '#$ % % $#' 
  - ' $$ % $$ ' 
  - '#@#@ @#@#' 
Bindings:
  # 绑定命令, 支持正则
  Commands:
    - 'opencd'
  Items:
    - 'material:nether_star' 



Icons:

  '#':
    display: 
      material: light_blue_stained_glass_pane 
      name: ' '
    action: 
      all: 
        - 'sound: BLOCK_NOTE_BLOCK_COW_BELL' 
  
  '@':
    display: 
      material: blue_stained_glass_pane 
      name: ' '
    action: 
      all: 
        - 'sound: BLOCK_NOTE_BLOCK_COW_BELL' 

  '$':
    display: 
      material: gray_stained_glass_pane 
      name: ' '
    action: 
      all: 
        - 'sound: BLOCK_NOTE_BLOCK_COW_BELL' 

  '%':
    display: 
      material: lime_stained_glass_pane 
      name: ' '
    action: 
      all: 
        - 'sound: BLOCK_NOTE_BLOCK_COW_BELL' 


  'Introduce':
    display: 
      material: writable_book
      name: '&6服务器介绍 &f[&8&oIntroduce&f]'
      slots: 31
      lore: 
      - ''
      - '&a使用/help获取常用指令帮助'
      - '&a➥请前往服务器wiki查询更多'
    action: 
      all: 
        - 'tell: &{#FFE1FF}&l请前往以下网址查看服务器WIKI:&f https://www.yuque.com/naixiya/tlh'
        - 'sound: BLOCK_NOTE_BLOCK_COW_BELL' 

   'Money'::
    display: 
      material: head:%player_name%
      name: '&6你当前拥有的各项资产 &f[&8&oMoney&f]'
      slots: 4
      lore: 
      - ''
      - '你当前拥有的星币: %coinsengine_balance_money%'
      - '你当前拥有的星辰点: '
      - '你当前拥有的建筑基质: %coinsengine_balance_building%'
      - '你当前拥有的粘液点: %coinsengine_balance_islands%'
      - '你当前拥有的考古经验: %coinsengine_balance_archaeology%'
    action: 
      all: 
        - 'close'
        - 'sound: BLOCK_NOTE_BLOCK_COW_BELL'


  'Resource_packs_settings':
    display: 
     material: head:eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvZTRkNDliYWU5NWM3OTBjM2IxZmY1YjJmMDEwNTJhNzE0ZDYxODU0ODFkNWIxYzg1OTMwYjNmOTlkMjMyMTY3NCJ9fX0=
     name: '&6关闭UI显示 &f[&8&oSettings&f]'
     slots: 9
     lore: 
     - ''
     - '&a➥ '
    action: 
      all: 
        - 'close'
        - 'open: 游戏设置' 
        - 'sound: BLOCK_NOTE_BLOCK_COW_BELL' 


  'lands':
    display: 
      material: light_blue_banner
      name: '&b领地帮助 &f[&8&olands&f]'
      slots: 23
